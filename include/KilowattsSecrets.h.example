/**
 * @file KilowattsSecrets.h.example
 * @brief Template for the Central Node's MQTT broker credentials.
 *
 * Copy this file to KilowattsSecrets.h (already listed in .gitignore) and
 * fill in the real values for your installation. KilowattsSecrets.h is
 * never committed to source control — MqttManager includes it, but this
 * project's git history and any published copy of this repository must
 * never carry a real password or broker credential.
 *
 * There is deliberately no compiled-in Wi-Fi SSID/password here: a
 * never-provisioned Central Node has no way to know a given site's Wi-Fi,
 * so it always boots straight into WiFiProvisioningPortal's self-hosted
 * setup Access Point until an installer supplies real credentials from a
 * phone (see src/central/main.cpp and lib/WiFiCredentialsStore).
 *
 * Smart Nodes do not include this file: they have no Wi-Fi/MQTT session of
 * their own (see EspNowCommunication) — only the Central Node bridges to
 * infrastructure Wi-Fi and MQTT.
 */

#ifndef KILOWATTS_SECRETS_H
#define KILOWATTS_SECRETS_H

#include <cstdint>

namespace kilowatts {
namespace Secrets {

/*
 * MQTT broker connectivity. Host and port are kept as two separate
 * fields (never a hand-combined "scheme://host:port" string) —
 * MqttManager::begin() is what combines them, through esp-mqtt's own
 * discrete broker.address.hostname/port/transport configuration fields.
 * MQTT_BROKER_USE_TLS alone selects the transport: true for a TLS broker
 * such as HiveMQ Cloud (port 8883) — MqttManager::begin() then verifies
 * it against ESP-IDF's bundled CA root store automatically
 * (esp_crt_bundle_attach), no certificate file needed here. Only set it
 * false for a broker you trust on a local/private network with no TLS
 * (typically port 1883).
 */
constexpr const char* MQTT_BROKER_HOST = "CHANGE_ME_BROKER_HOST";
constexpr std::uint16_t MQTT_BROKER_PORT = 8883U;
constexpr bool MQTT_BROKER_USE_TLS = true;
constexpr const char* MQTT_USERNAME = "CHANGE_ME_MQTT_USERNAME";
constexpr const char* MQTT_PASSWORD = "CHANGE_ME_MQTT_PASSWORD";

} // namespace Secrets
} // namespace kilowatts

#endif // KILOWATTS_SECRETS_H
